@article{zhang2026hooksteg,
  title = {HookSteg: A Truly Lossless Steganography Based on Process Hooking for Lossy Network Channels},
  author = {Mingliang Zhang and Yi Zhang and Yanmei Liu and Wentong Fan and Xiangyang Luo},
  year = {2026},
  doi = {10.1109/tifs.2026.3707784},
  url = {https://doi.org/10.1109/tifs.2026.3707784},
  abstract = {Covert communication often relies on image steganography to transmit sensitive data such as commercial secrets. Any minor bit error can lead to catastrophic consequences, which imposes extremely high demands on the zero-error transmission of secret information. However, existing robust image steganographic schemes still fail to guarantee zeroerror recovery of secret bits when resisting hybrid attacks such as compression and scaling on social platforms. To address this issue, we propose a lossless steganographic method called HookSteg, which bypasses lossy attacks on social platforms through process hooking, thereby achieving lossless steganography. This method first identifies nodes afected by lossy attacks through tracking whether image data has been compromised. Subsequently, a method for capturing lossy attack instructions is proposed based on syntax-semantic joint features and dynamic taint tracking techniques. Finally, process hooking is utilized to bypass lossy attack instructions, ensuring the lossless transmission of secret information. Experimental results on transmission scenarios with tens of millions of daily active users, such as Youku and Kutumb, demonstrate that HookSteg is general and requires no modifications to existing steganographic algorithms. It achieves, for the first time, lossless transmission of secret information in real-world scenarios, with an average improvement in extraction accuracy of 36.63%. Additionally, its eficiency in locating attack instructions is improved by 94.34% compared to traditional manual reverse engineering methods. Furthermore, this study resolves the tradeof among embedding capacity, security, and robustness, enabling steganography to focus on enhancing security and capacity, thereby providing a general and eficient solution for lossless steganography. Index Terms—Covert communication, image steganography, lossy channel, lossless steganography, robustness.},
}

