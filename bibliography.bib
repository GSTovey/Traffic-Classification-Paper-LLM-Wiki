@article{gu2026bridging,
  title = {Bridging Packet and Session: Cross-Level Dual-Attention Networks for Encrypted Traffic Classification},
  author = {Jieming Gu and Yue Zhong and Xiangzhan Yu},
  year = {2026},
  doi = {10.1007/s44443-026-00470-7},
  abstract = {The widespread adoption of encryption technologies has greatly increased the complexity of network traffic classification, as plaintext features such as DNS are increasingly unavailable. Traditional payload-based approaches fail under strong encryption, while statistical and deep learning methods relying on single-level information often struggle to capture comprehensive traffic patterns. To address these challenges, we propose Cross-Level Encrypted Traffic (CLET), a novel classification model that integrates session-level and packet-level representations to capture comprehensive patterns in encrypted traffic. At the session level, CLET constructs an 87-dimensional attribute set encompassing certificate characteristics, temporal behaviors, and spatial distributions, providing a robust global view of each flow. At the packet level, CLET introduces a compact 13-dimensional attribute set processed by a hybrid CNN-Transformer network with dual attention mechanisms, learning fine-grained temporal and spatial dependencies while avoiding redundant information. By jointly leveraging global and local representations, CLET mitigates information loss and enhances feature discriminability. Experiments on the LFETT2021 and ISCX-VPN datasets show that CLET outperforms state-of-the-art baselines, demonstrating the effectiveness of cross-level learning for encrypted traffic classification. Keywords: Encrypted traffic classification, Application identification, Cross-level feature learning, Deep learning},
}

@article{wen2026graph,
  title = {Graph-Based Contrastive Learning and Clustering for Open-World Encrypted Traffic Classification},
  author = {Jigang Wen and Xiyu Zhang and Kun Xie and Yuxiang Zeng and Kun Huang and Yudian Ouyang and Wei Liang},
  year = {2026},
  doi = {10.1109/tifs.2026.3705313},
  url = {https://doi.org/10.1109/tifs.2026.3705313},
  abstract = {Encrypted trafic classification is essential for modern network management and security, yet remains highly challenging due to payload encryption, data imbalance, and the emergence of unknown trafic classes. Existing methods often assume closed-world settings, rely on handcrafted features, or lack robustness in dynamic environments. To address these limitations, we propose a unified Graph-based Contrastive Learning and Clustering (GCLC) framework for encrypted trafic classification in open-world scenarios. Encrypted flows are modeled as trafic interaction graphs using lightweight packetlevel features. We train a Graph Neural Network (GNN) encoder with a hybrid loss function, integrating supervised contrastive learning and center-aware loss to promote the aggregation of samples into class clusters with clear boundaries between clusters. To enhance robustness under limited and imbalanced data, we design a trafic-aware graph augmentation strategy that simulates the variability of real-world network conditions. To discover new classes, we introduce a Mahalanobis distance-based new class detector and an adaptive model update mechanism that can detect and integrate unseen trafic classes. GCLC is evaluated on 3 public datasets and 1 self-collected dataset. Experimental results show that it outperforms existing methods on 4 evaluation metrics, with an open-set new class recognition accuracy of 95.02%. Even under scenarios of severe class imbalance and unknown classes, it still maintains high performance, exhibits strong robustness and adaptability, confirming the efectiveness of the framework in real-world encrypted dynamic trafic environments. Index Terms—Encrypted trafic classification, graph augmentation, contrastive learning, graph neural networks (GNNs), graph-level clustering.},
}

@inproceedings{liu2026practical,
  title = {Practical Covert Channel across Isolated Browser Instances via GPU Command Queue Contention},
  author = {Jinhong Liu and Zifeng Kang and Song Li and Yinzhi Cao},
  year = {2026},
  doi = {10.1109/sp63933.2026.00254},
  url = {https://doi.org/10.1109/sp63933.2026.00254},
  abstract = {Web storages, e.g., cookies, are isolated across different browser modes (e.g., normal vs. incognito) and browsers (e.g., Chrome vs. Safari) to ensure user privacy. Despite such browser-level isolation, researchers have found covert communication channels between different modes and browsers, which can break such a security mechanism. However, existing covert communications are impractical and unreliable in the real world scenarios, where noise is prevalent. Furthermore, multiple prior covert channels only support cross-mode—not crossbrowser—communications, because the relevant resources are shared within a single browser. In this paper, we discover a novel covert channel due to GPU command queue contention and then design a framework, called C<sup>3</sup>F, for both cross-mode and cross-browser covert communication. C<sup>3</sup>F negotiates an adaptive communication speed between the sender and the receiver and then facilitates the covert communication. We evaluated C<sup>3</sup>F in real-world settings by deploying it to crowd-sourced workers on Amazon Mechanical Turk, simply asking them to visit two websites without imposing additional constraints. Our evaluation shows that covert communication achieves a 100% accuracy once the data transmission is completed, with an overall completion rate of 92.81% across 1,434 AMT experiments. So far, Firefox, Safari and Tor developers have confirmed our attack and are working with us on practical defenses.},
}

@article{jia2026early,
  title = {Early-Stage Detection of Encrypted Malware Traffic via Multi-Flow Temporal Graph Learning},
  author = {Jizhe Jia and Yi Zhao and Meng Shen and Susu Cui and Jing Wang and Bufan Zhao and Wei Wang and Liehuang Zhu},
  year = {2026},
  doi = {10.1109/tifs.2026.3685079},
  abstract = {Malware widely adopts network trafic encryption techniques to conceal malicious activities. Recent research has demonstrated the efectiveness of machine learning (ML)-, deep learning (DL)-, and pre-training-based malware trafic detection methods. However, a vast majority of these methods rely on the collected complete trafic during the malware attack. While certain methods can operate on partial trafic, their detection accuracy often significantly decreases when the available data is restricted to the extreme early stage, where information is most sparse. In this paper, we propose DawnGuard, an efective earlystage encrypted malware trafic detection framework through multi-flow temporal graph learning. Specifically, based on the temporal packet density distribution analysis, DawnGuard innovatively proposes a self-adjusting data augmentation strategy for early-stage malware trafic, which can force the model to focus on the early-stage interaction phase with more distinguishable properties. Meanwhile, considering that temporal-topological correlations among multiple flows can provide more distinguishable properties in a malware attack, we further develop a temporal graph learning framework to extract features, which can form Multi-Flow Graph Features (MGF). By utilizing MGF, DawnGuard implements a Vision Transformer-based detection mechanism, enabling accurate and precise encrypted malware trafic detection with early-stage trafic by capturing both local and global contextual relationships. Extensive experiments with two real-world datasets demonstrate that DawnGuard outperforms the state-of-the-art (SOTA) methods in three typical scenarios: varying early-stage time windows, imbalanced data, and unseen malware detection. Particularly, DawnGuard achieves an average F1 of 95.11%, 8.7% higher than the SOTA method, by only utilizing the first 20% loading ratio of complete trafic. Index Terms—Malware trafic detection, encrypted trafic analysis, graph learning.},
}

